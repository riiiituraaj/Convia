# CONVIA Environment Configuration

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./convia.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/convia
REDIS_URL=redis://localhost:6379/0

# Nebius Token Factory / NVIDIA Nemotron Inference
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
NEBIUS_FAST_MODEL=nvidia/nemotron-mini-4b-instruct

# NVIDIA NIM / Cloud Endpoints
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_ASR_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TTS_URL=https://integrate.api.nvidia.com/v1

# Tavily Search API
TAVILY_API_KEY=

# Authentication & Security
AUTH_SECRET=lifeos-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client Configuration (include /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_ENABLE_BROWSER_SPEECH_FALLBACK=true

