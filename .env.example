# Copy to .env for local Docker Compose use. Replace placeholders locally; never commit .env.

# Runtime and persistence
APP_ENV=development
LIFEOS_DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./convia.db
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value

# Authentication (optional in development; required in production, minimum 32 characters)
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Browser origins allowed by the API. Use JSON array syntax for multiple origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Select exactly one route: nebius, nvidia, or disabled.
AI_PROVIDER=disabled
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1

# Nebius Token Factory (server-side only). Verify model availability in your account.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_NEMOTRON_MODEL=
NEBIUS_FAST_MODEL=
NEBIUS_REASONING_MODEL=

# NVIDIA NIM (server-side only). This key can also enable opt-in NVIDIA Parakeet audio transcription.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=
NVIDIA_NIM_FAST_MODEL=
NVIDIA_NIM_REASONING_MODEL=

# Tavily Search API (server-side only)
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=5

# Private document storage (defaults to repository local_data/documents)
# For Compose, the API container uses its persistent documents_data volume.
DOCUMENT_MAX_UPLOAD_BYTES=15728640
DOCUMENT_MAX_USER_BYTES=262144000
DOCUMENT_MAX_USER_FILES=100

# Public browser configuration. This value is embedded in the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
